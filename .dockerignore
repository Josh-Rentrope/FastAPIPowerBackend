# The reference data is ~125 MB (an 84 MB TIGER shapefile, 40 MB of GeoNames
# cities) and belongs to the ETL, not the API. Without this the image grows by
# more than an order of magnitude for files the server never opens.
lookups/*.zip
lookups/*.shp
lookups/*.shx
lookups/*.dbf
lookups/*.prj
lookups/*.txt
lookups/*.csv
lookups/*.xml

